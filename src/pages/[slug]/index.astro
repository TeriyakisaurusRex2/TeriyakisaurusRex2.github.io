---
// Standalone page for each Watch project (Unity builds, hardware, mods...), served at
// teriyakisaurusrex2.github.io/<repo-name>/. It deliberately has no links to the rest of the site.
// Playable projects don't get one: their own repo's GitHub Pages site lives at that address.
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects.js';
import { relative, absolute } from '../../lib/dates.js';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .filter((p) => p.type === 'watch')
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: p } = Astro.props;

// With no media yet, show a single placeholder slide so the layout holds.
const media = p.media.length > 0 ? p.media : [{ kind: 'placeholder', caption: 'Screenshots coming soon', isMotion: false }];
let shot = 0;
const slides = media.map((m) => {
  if (p.media.length === 0) return { ...m, label: m.caption };
  if (!m.isMotion) shot++;
  const label = m.isMotion ? (m.caption ?? 'Video') : `Screenshot ${shot}${m.caption ? ` · ${m.caption}` : ''}`;
  return { ...m, label };
});

const blobs = [
  { w: 620, h: 520, x: '-180px', y: 40, color: '#C8D3DF' },
  { w: 520, h: 460, x: 'calc(100% - 400px)', y: 360, color: '#C9D6C3' },
  { w: 600, h: 520, x: '20%', y: 1500, color: '#E9D1C9' },
  { w: 560, h: 500, x: 'calc(100% - 420px)', y: 2300, color: '#E6DCC4' },
];
const playIcon = '<svg width="16" height="16" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 1.8v8.4l7-4.2z" fill="currentColor"/></svg>';
---
<Base title={p.name} description={p.description} blobs={blobs}>
  <header class="project-header">
    <div style="display:flex;flex-direction:column;gap:14px">
      <span class="project-kicker">{[p.engine, 'watch'].filter(Boolean).join(' · ')}</span>
      <h1>{p.name}</h1>
      {p.description && <p class="tagline">{p.description}</p>}
    </div>
    <span class="updated-note">updated <span data-rel={p.updated}>{relative(p.updated)}</span></span>
  </header>

  <div class="main">
    <section class="glass viewer" aria-label="Screenshots and video" id="viewer">
      <div class="stage" style={`background-color:${p.tint}`}>
        {slides.map((m, i) => (
          <div class="slide" data-slide={i} hidden={i !== 0}>
            {m.kind === 'image' && <img src={m.src} alt={m.caption ?? ''} loading={i === 0 ? 'eager' : 'lazy'} />}
            {m.kind === 'video' && <video src={m.src} controls preload="metadata" playsinline />}
            {m.kind === 'youtube' && (
              <iframe
                src={i === 0 ? `https://www.youtube-nocookie.com/embed/${m.ytId}` : undefined}
                data-src={`https://www.youtube-nocookie.com/embed/${m.ytId}`}
                title={m.caption ?? 'Video'}
                allow="encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen
              />
            )}
            {m.kind === 'placeholder' && (
              <div class="slide slide-empty">
                {m.isMotion && <span class="big-play" aria-hidden="true" set:html={playIcon.replace(/16/g, '26')} />}
              </div>
            )}
            <span class="caption">{m.label}</span>
          </div>
        ))}
        {slides.length > 1 && (
          <>
            <button type="button" class="round prev" aria-label="Previous" data-step="-1"><svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2L3.5 6l4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
            <button type="button" class="round next" aria-label="Next" data-step="1"><svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
          </>
        )}
      </div>
      {slides.length > 1 && (
        <div class="strip-row">
          <div class="strip" role="group" aria-label="Choose screenshot or video">
            {slides.map((m, i) => (
              <button type="button" class="mini" data-goto={i} aria-label={`Show ${m.label}`} aria-current={i === 0 ? 'true' : 'false'} style={`background-color:${p.tint}`}>
                {m.kind === 'image' && <img src={m.src} alt="" loading="lazy" />}
                {m.kind === 'youtube' && <img src={`https://i.ytimg.com/vi/${m.ytId}/mqdefault.jpg`} alt="" loading="lazy" />}
                {m.isMotion && <span class="mini-play" set:html={playIcon} />}
              </button>
            ))}
          </div>
          <span class="position" aria-live="polite"><span id="pos">1</span> / {slides.length}</span>
        </div>
      )}
    </section>

    <aside class="glass details" aria-label="Project details">
      {(p.about ?? p.description) && <p class="details-text">{p.about ?? p.description}</p>}
      <dl class="facts">
        {p.engine && <><dt>engine</dt><dd>{p.engine}</dd></>}
        {p.language && <><dt>language</dt><dd>{p.language}</dd></>}
        {p.status && <><dt>status</dt><dd><span class="status"><span class="dot" aria-hidden="true"></span>{p.status}</span></dd></>}
        <dt>created</dt><dd>{absolute(p.created)}</dd>
        <dt>last updated</dt><dd><span data-rel={p.updated}>{relative(p.updated)}</span><small>{absolute(p.updated)}</small></dd>
      </dl>
      {p.tags.length > 0 && (
        <div class="chips">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
      )}
      {p.repoUrl && (
        <a class="source-btn" href={p.repoUrl}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 4.5L2 8l3.5 3.5M10.5 4.5L14 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          View source on GitHub
        </a>
      )}
    </aside>
  </div>

  {/* The about section only appears when there's a README (from the repo, or the showcase folder). */}
  {p.readmeHtml && (
    <section class="about" aria-labelledby="about-h">
      <div class="main">
        <div>
          <div class="about-head">
            <h2 id="about-h" class="label">about</h2>
          </div>
          <article class="glass md" set:html={p.readmeHtml} />
        </div>
      </div>
    </section>
  )}

  <footer class="site-footer">
    <div class="vline" aria-hidden="true"></div>
    <span>made by [your name]</span>
  </footer>
</Base>

<script>
  // Media viewer: show one slide at a time; arrows, thumbnails and the keyboard switch it.
  const viewer = document.getElementById('viewer');
  const slides = [...viewer.querySelectorAll('[data-slide]')];
  const minis = [...viewer.querySelectorAll('[data-goto]')];
  const pos = document.getElementById('pos');
  let index = 0;

  function show(next) {
    const old = slides[index];
    // Stop anything playing on the slide we're leaving.
    old.querySelector('video')?.pause();
    const oldFrame = old.querySelector('iframe');
    if (oldFrame) oldFrame.removeAttribute('src');

    index = (next + slides.length) % slides.length;
    slides.forEach((s, i) => (s.hidden = i !== index));
    minis.forEach((m, i) => m.setAttribute('aria-current', String(i === index)));
    minis[index]?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    // YouTube embeds only load when shown, so the page stays light.
    const frame = slides[index].querySelector('iframe');
    if (frame && !frame.getAttribute('src')) frame.setAttribute('src', frame.dataset.src);
    if (pos) pos.textContent = String(index + 1);
  }

  for (const btn of viewer.querySelectorAll('[data-step]')) {
    btn.addEventListener('click', () => show(index + Number(btn.dataset.step)));
  }
  minis.forEach((m, i) => m.addEventListener('click', () => show(i)));
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
